{
  "schema_version": "1.0",
  "suite_id": "ssuksak.monthly-golden",
  "suite_version": "monthly-golden-v0.1.2-m1d",
  "created_on": "2026-09-11",
  "purpose": "Monthly M1 Vertical Slice의 Gate와 Generate 구조를 고정한다. M1-B 범위만 담고 M1-C/M1-D에서 같은 suite에 additive로 확장한다.",
  "contract_stage": "M1-D",
  "scope_note": "Monthly M1 Core의 Gate / Generate / Edit / Regenerate / Confirm 전 범위를 담는다. Reference invalidation의 세부 변형은 Application test가 담당하고 Golden은 Contract 대표 case를 유지한다.",
  "assertion_policy": {
    "exact_sentence_match": false,
    "exact_theme_label_match": false,
    "assert_structure": true,
    "assert_gate_order": true,
    "assert_reference_resolution": true,
    "assert_validation_result": true
  },
