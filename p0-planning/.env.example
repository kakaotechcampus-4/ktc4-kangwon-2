# 쓱싹요정 P0 — 로컬 개발용 환경변수 예시
#
# 사용법
#   1. 이 파일을 `.env`로 복사한다.
#   2. 각 값을 본인 환경 값으로 채운다.
#   3. `.env`는 .gitignore에 걸려 있으므로 커밋되지 않는다.
#
# 주의
#   - 이 파일(.env.example)에는 실제 API Key나 실제 endpoint를 적지 않는다.
#     여기에 적은 값은 저장소에 그대로 커밋된다.
#   - `.env`는 이미 설정된 OS 환경변수를 덮어쓰지 않는다(override=False).
#     CI·배포에서 주입한 값이 로컬 파일에 밀리지 않게 하기 위함이다.
#   - 기존 이름(PROXY_TOKEN / CHAT_PROXY_URL / OPENAI_MODEL)은 지원하지 않는다.
#     아래 이름으로 통일한다.

# ---------------------------------------------------------------- Elice MLAPI
# Elice MLAPI는 OpenAI-compatible API를 제공한다. base_url은 **API 루트**여야
# 하며 `/v1`까지만 적는다. `/chat/completions` 같은 엔드포인트 경로를 포함하면
# SDK가 그 뒤에 경로를 또 붙여 요청이 깨진다.
ELICE_MLAPI_BASE_URL=https://<mlapi-host>/v1

# Elice Serverless API Key. 실제 값은 `.env`에만 넣는다.
ELICE_MLAPI_API_KEY=<your-elice-serverless-api-key>

# ---------------------------------------------------------------- Model
# 코드에 기본값이 없는 필수 항목이다. endpoint의 GET /v1/models 값과 일치시킨다.
# 현재 개발·통합 기준 후보는 gpt-4.1-mini 계열이며 최종 모델은 미확정이다.
LLM_MODEL=<model-id-from-GET-/v1/models>

# ---------------------------------------------------------------- 호출 정책
# 수치는 제품 결정 전이므로 코드 기본값이 없다. 반드시 명시한다.
# 재시도는 Adapter가 직접 세므로 최악 대기는 timeout x (max_retries + 1)이다.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# reasoning effort: minimal | low | medium | high | none
# reasoning 미지원 모델(예: gpt-4.1-mini)에서는 none으로 두어 파라미터를
# 전송하지 않게 한다. P0 초기값 low는 provisional이다.
LLM_REASONING_EFFORT=none

# ---------------------------------------------------------------- 선택 항목
# responses | chat_completions
# 기본값은 responses다. MLAPI가 /v1/responses를 지원하지 않거나 Structured
# Output 호환 문제가 있을 때만 chat_completions로 전환한다.
# LLM_API_STYLE=responses

# 출력 토큰 상한. 미설정이면 파라미터를 보내지 않는다.
# LLM_MAX_OUTPUT_TOKENS=4096

# ---------------------------------------------------------------- Live Test
# 1로 두면 실제 MLAPI를 호출하는 Live Smoke Test가 실행된다.
# 기본값은 0이며, 일반 pytest 실행에서는 `-m "not live"`로도 제외된다.
RUN_LIVE_LLM_TESTS=0
