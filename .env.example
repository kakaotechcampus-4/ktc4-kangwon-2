# cp .env.example .env 로 복사하고 비밀번호를 바꾼다. .env 는 커밋하지 않는다.
# POSTGRES_PASSWORD 와 DATABASE_URL 안의 비밀번호는 같은 값이어야 한다.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://ssuksak:change-me@db:5432/ssuksak

# 엘리스 MLAPI. **이 두 이름이어야 한다** — 코드가 찾는 이름이다.
# 예전 ELICE_API_KEY 는 아무도 읽지 않는다.
#
# **주소는 `/v1` 까지 적는다.** 코드가 뒤에 `/chat/completions` 를 붙인다.
# **엘리스는 모델마다 주소가 다르다.** 이 주소가 ADR-023 의 모델(`openai/gpt-6.1-sol`)을
# 가리켜야 한다 — 어긋나면 키가 멀쩡해도 `model_not_found` 가 난다.
#   예:  https://mlapi.run/<모델 UUID>/v1
#   그 주소에서 쓸 수 있는 이름:  GET <주소>/models
ELICE_MLAPI_BASE_URL=
ELICE_MLAPI_API_KEY=
# 판정 전용 모델 jev 주소(ADR-069). 키는 위 ELICE_MLAPI_API_KEY 를 같이 쓴다. 비우면 일지 AI 검토만 503.
ELICE_JEV_BASE_URL=
# mock | real — 이 둘 외의 값은 기동 시점에 에러
LLM_MODE=mock
# 주간계획안을 실제 LLM 으로 만들지(W7). LLM_MODE=real 이어도 이것이 0 이면 주간은 503 이다.
# 실제 문장 품질을 실측(W7b)으로 확인한 뒤에 1 로 켠다.
WEEKLY_LLM_ENABLED=0
IS_SERVER=0
# 운영 서버에서만 쓴다. 로컬에서 켜면 backend 가 안 뜬다(ADR-058).
# COMPOSE_FILE=docker-compose.yml:docker-compose.server.yml

# 로그인 토큰 서명 열쇠. 아무 긴 문자열이면 된다 — 만드는 법:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 바꾸면 이미 발급된 토큰이 전부 무효가 된다(교사가 다시 로그인).
SECRET_KEY=change-me

# 카카오 로그인 (ADR-063). 비어 있으면 카카오 단추만 「지금은 쓸 수 없어요」이고 이메일 로그인은 돈다.
# developers.kakao.com → 내 애플리케이션 → 앱 키의 「REST API 키」.
# REDIRECT_URI 는 콘솔 「카카오 로그인 → Redirect URI」에 등록한 값과 글자 하나까지 같아야 한다.
#   로컬  http://localhost:3000/login/kakao     서버  https://ssample.duckdns.org/login/kakao
# CLIENT_SECRET 은 콘솔 「보안」에서 켰을 때만 넣는다.
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=
KAKAO_CLIENT_SECRET=

# 트렌드 수집 (ADR-016). 주 1회 작업에서만 쓴다.
# 없으면 그 소스만 건너뛰고 나머지는 모은다 — 기동은 막지 않는다.
YOUTUBE_API_KEY=
# 네이버 검색 API 는 2026 에 개발자센터에서 네이버 클라우드 플랫폼(API HUB)으로
# 옮겨갔다. console.ncloud.com 에서 앱을 만들고 받은 Client ID · Secret 을 넣는다.
# 개발자센터(developers.naver.com)에서 받은 옛 키는 401 로 떨어진다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 도서관 정보나루(data4library.kr). 사람이 심사하므로 발급에 며칠 걸린다.
LIBRARY_AUTH_KEY=

# 일지 날씨 (ADR-089). 공공데이터포털(data.go.kr) 인증키 하나로 두 API 를 같이 부른다 —
#   「기상청_단기예보 ((구)_동네예보) 조회서비스」 · 「한국환경공단_에어코리아_대기오염정보」.
# 두 API 를 각각 활용신청해야 같은 키로 둘 다 열린다. 마이페이지의 일반 인증키 Encoding · Decoding 어느 쪽을
# 넣어도 된다 — 서버가 한 번 풀어서 보낸다(routines/weather.py `_service_key`).
# 비어 있거나 호출이 실패하면 날씨가 「값 없음」일 뿐이다 — 기동 · 일지 · 내보내기는 그대로 돈다.
DATA_GO_KR_SERVICE_KEY=
# mock | real — LLM_MODE 와 같은 규칙. real 은 IS_SERVER=1 일 때만 부른다(로컬 real 은 안 부른다).
# mock 은 로컬에서 가짜 값(맑음 · 보통)을 쓰고, 서버에서는 아무것도 부르지 않는다(값 없음).
WEATHER_MODE=mock

# ── 시험용 · 파일럿 시작 전에 반드시 끈다 ─────────────────────────────────
#
# 연간계획안을 확정하면 고칠 수도(화면의 「내용 수정」이 꺼진다) 지울 수도
# (`DELETE` 가 확정본을 막는다) 없다. 계획안에는 일지와 달리 `unconfirm` 이 없어서
# 빠져나올 구멍이 없다. 시험하는 동안만 「연간 + 딸린 월간 전부 지우기」를 연다.
#
# **둘 다 켜야 보인다. 둘 다 기본은 꺼짐이다.**
#   꺼져 있으면 서버 경로가 404 다 — 단추만 켜져도 아무것도 지워지지 않는다.
#   파일럿 전에 두 줄을 지우거나 0 으로 바꾸고 다시 배포한다.
ALLOW_TEST_RESET=0
NEXT_PUBLIC_ALLOW_TEST_RESET=0
