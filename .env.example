# cp .env.example .env 로 복사하고 비밀번호를 바꾼다. .env 는 커밋하지 않는다.
# POSTGRES_PASSWORD 와 DATABASE_URL 안의 비밀번호는 같은 값이어야 한다.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://ssuksak:change-me@db:5432/ssuksak

# 엘리스 MLAPI. **이 두 이름이어야 한다** — 코드가 찾는 이름이다.
# 예전 ELICE_API_KEY 는 아무도 읽지 않는다.
#
# **주소는 `/v1` 까지 적는다.** 코드가 뒤에 `/chat/completions` 를 붙인다.
# **엘리스는 모델마다 주소가 다르다.** 이 주소가 ADR-023 의 모델(`openai/gpt-6-luna`)을
# 가리켜야 한다 — 어긋나면 키가 멀쩡해도 `model_not_found` 가 난다.
#   예:  https://mlapi.run/<모델 UUID>/v1
#   그 주소에서 쓸 수 있는 이름:  GET <주소>/models
ELICE_MLAPI_BASE_URL=
ELICE_MLAPI_API_KEY=
# mock | real — 이 둘 외의 값은 기동 시점에 에러
LLM_MODE=mock
# 주간계획안을 실제 LLM 으로 만들지(W7). LLM_MODE=real 이어도 이것이 0 이면 주간은 503 이다.
# 실제 문장 품질을 실측(W7b)으로 확인한 뒤에 1 로 켠다.
WEEKLY_LLM_ENABLED=0
IS_SERVER=0

# 로그인 토큰 서명 열쇠. 아무 긴 문자열이면 된다 — 만드는 법:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 바꾸면 이미 발급된 토큰이 전부 무효가 된다(교사가 다시 로그인).
SECRET_KEY=change-me

# 트렌드 수집 (ADR-016). 주 1회 작업에서만 쓴다.
# 없으면 그 소스만 건너뛰고 나머지는 모은다 — 기동은 막지 않는다.
YOUTUBE_API_KEY=
# 네이버 검색 API 는 2026 에 개발자센터에서 네이버 클라우드 플랫폼(API HUB)으로
# 옮겨갔다. console.ncloud.com 에서 앱을 만들고 받은 Client ID · Secret 을 넣는다.
# 개발자센터(developers.naver.com)에서 받은 옛 키는 401 로 떨어진다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 도서관 정보나루(data4library.kr). 사람이 심사하므로 발급에 며칠 걸린다.
LIBRARY_AUTH_KEY=

# ── 시험용 · 파일럿 시작 전에 반드시 끈다 ─────────────────────────────────
#
# 연간계획안을 확정하면 고칠 수도(화면의 「내용 수정」이 꺼진다) 지울 수도
# (`DELETE` 가 확정본을 막는다) 없다. 계획안에는 일지와 달리 `unconfirm` 이 없어서
# 빠져나올 구멍이 없다. 시험하는 동안만 「연간 + 딸린 월간 전부 지우기」를 연다.
#
# **둘 다 켜야 보인다. 둘 다 기본은 꺼짐이다.**
#   꺼져 있으면 서버 경로가 404 다 — 단추만 켜져도 아무것도 지워지지 않는다.
#   파일럿 전에 두 줄을 지우거나 0 으로 바꾸고 다시 배포한다.
ALLOW_TEST_RESET=0
NEXT_PUBLIC_ALLOW_TEST_RESET=0
